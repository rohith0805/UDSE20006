<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Cart - FoodExpress
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/order.css"
    >

</head>


<body>

    <%- include("partials/navbar") %>


    <main class="container">

        <h1 class="page-title">
            🛒 Your Cart
        </h1>


        <div id="cartItems"></div>


        <div class="cart-summary">

            <h2>
                Total:
                ₹<span id="cartTotal">0</span>
            </h2>

            <a
                href="/checkout"
                class="btn"
                id="checkoutButton"
            >
                Proceed to Checkout
            </a>

        </div>

    </main>


    <%- include("partials/footer") %>


    <script
        src="/js/cart.js"
    ></script>

</body>

</html>