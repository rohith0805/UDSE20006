<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        FoodExpress
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>

    <%- include("partials/navbar") %>


    <section class="hero">

        <div class="hero-content">

            <h1>
                Delicious Food,
                Delivered Fast
            </h1>

            <p>
                Order your favourite food
                from the best restaurants.
            </p>

            <a
                href="/restaurants"
                class="btn"
            >
                Explore Restaurants
            </a>

        </div>

    </section>


    <section class="features container">

        <div class="feature-card">

            <div class="feature-icon">
                🍕
            </div>

            <h3>
                Great Food
            </h3>

            <p>
                Delicious food from
                your favourite restaurants.
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                🚴
            </div>

            <h3>
                Fast Delivery
            </h3>

            <p>
                Get your food delivered
                quickly to your doorstep.
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                🔒
            </div>

            <h3>
                Secure Ordering
            </h3>

            <p>
                Safe and secure online
                food ordering.
            </p>

        </div>

    </section>


    <%- include("partials/footer") %>

</body>

</html>