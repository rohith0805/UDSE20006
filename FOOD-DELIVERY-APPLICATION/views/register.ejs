<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Register - FoodExpress
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/login.css"
    >

</head>


<body>

    <%- include("partials/navbar") %>


    <main class="auth-container">

        <div class="auth-card">

            <h1>
                Create Account
            </h1>

            <p>
                Register to start ordering.
            </p>


            <% if (error) { %>

                <div class="error-message">
                    <%= error %>
                </div>

            <% } %>


            <form
                action="/auth/register"
                method="POST"
            >

                <label>
                    Name
                </label>

                <input
                    type="text"
                    name="name"
                    placeholder="Enter your name"
                    required
                >


                <label>
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >


                <label>
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="Minimum 6 characters"
                    minlength="6"
                    required
                >


                <button
                    type="submit"
                    class="btn"
                >
                    Register
                </button>

            </form>


            <p class="auth-footer">

                Already have an account?

                <a href="/auth/login">
                    Login
                </a>

            </p>

        </div>

    </main>


    <%- include("partials/footer") %>

</body>

</html>